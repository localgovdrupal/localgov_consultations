<?php

/**
 * @file
 * Adds Localgov Consultation Webform field as a child of group_webform
 * and enables it in manage display settings.
 */

/**
 * Implements hook_install().
 */
function localgov_consultations_webform_install() {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Configure form display.
  $form_display = $entity_type_manager->getStorage('entity_form_display')->load('node.consultation.default');
  if ($form_display) {
    $form_display->setComponent('localgov_consultation_webform', [
      'type' => 'webform_entity_reference_select',
      'weight' => 20,
    ]);
    _localgov_consultations_webform_add_to_field_group($form_display, 'group_webform');
    $form_display->save();
  }

  // Configure view display.
  $view_display = $entity_type_manager->getStorage('entity_view_display')->load('node.consultation.default');
  if ($view_display) {
    $view_display->setComponent('localgov_consultation_webform', [
      'type' => 'webform_entity_reference_entity_view',
      'weight' => 20,
    ]);
    $view_display->save();
  }
}

/**
 * Helper to add field to a field group.
 */
function _localgov_consultations_webform_add_to_field_group($display, $group_name) {
  $field_groups = $display->getThirdPartySettings('field_group');
  if (isset($field_groups[$group_name]) && !in_array('localgov_consultation_webform', $field_groups[$group_name]['children'])) {
    $field_groups[$group_name]['children'][] = 'localgov_consultation_webform';
    $display->setThirdPartySetting('field_group', $group_name, $field_groups[$group_name]);
  }
}
